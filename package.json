{
  "name": "mosaik-starter-svelte",
  "version": "0.0.0",
  "private": true,
  "description": "An independent Mosaik starter for Svelte.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": "^24.15.0 || >=26.0.0"
  },
  "scripts": {
    "dev": "vite",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "svelte-check --tsconfig ./tsconfig.app.json && tsc -p tsconfig.node.json",
    "test": "vitest run",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview"
  },
  "dependencies": {
    "@pixel-brewery/mosaik-elements-foundation": "0.1.177",
    "@pixel-brewery/mosaik-elements-svelte": "0.1.177",
    "@pixel-brewery/mosaik-icons": "0.1.177",
    "@pixel-brewery/mosaik-themes": "0.1.177",
    "reflect-metadata": "0.2.2",
    "svelte": "5.57.2"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@tsconfig/svelte": "5.0.8",
    "@types/node": "26.6.5",
    "eslint": "10.13.0",
    "eslint-plugin-svelte": "3.23.1",
    "globals": "17.13.0",
    "happy-dom": "21.0.4",
    "svelte-check": "4.7.7",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  },
  "overrides": {
    "@pixel-brewery/mosaik-elements": "0.1.171"
  }
}
